        <mxCell id="c113" value="&lt;i&gt;Use:&lt;/i&gt; Transparency-in-coverage negotiated rates to benchmark unit cost against market." style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=wrap;fontSize=11;fontFamily=Consolas;" vertex="1" parent="c111"><mxGeometry x="0" y="58" width="340" height="32" as="geometry"/></mxCell>
        <mxCell id="c115" value="«extends»" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;dashed=1;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#2d6a2d;fontColor=#2d6a2d;endArrow=block;endFill=0;edgeStyle=none;strokeWidth=2;" edge="1" parent="1" source="c114" target="c37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c116" value="&lt;b&gt;How to add an extension&lt;/b&gt;: put the new function in the lane's module with a STANDARD/ALTERNATIVE docstring, add its knobs to &lt;code&gt;Config&lt;/code&gt;, a &lt;code&gt;check_*&lt;/code&gt; returning &lt;code&gt;Finding&lt;/code&gt; for its assumptions, and a test in &lt;code&gt;tests/&lt;/code&gt; that compares it with the current method on the seeded data (docs/ADDING_A_TEMPLATE.md, docs/CONVENTIONS.md §2). Templates never import each other — copy helpers, as prep.py does from t00." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="1614" width="1600" height="50" as="geometry"/></mxCell>
