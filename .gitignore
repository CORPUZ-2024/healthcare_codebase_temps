# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.ipynb_checkpoints/

# Template run artefacts (regenerated by run.py)
templates/*/outputs/*
!templates/*/outputs/.gitkeep

# Downloaded public-use files are never committed (licensing + size)
templates/*/data/*
!templates/*/data/README.md
!templates/*/data/.gitkeep

# Orchestrator history (LATEST.* stays committed so GitHub shows the last status)
orchestrator/run_status/history/
orchestrator/run_status/run_log.csv

# OS / editor
.DS_Store
Thumbs.db
